# Những thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Không cần lúc runtime
tests
screenshots
solution
*.md
*.log
docker-compose.yml
Dockerfile
.dockerignore
